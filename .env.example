# MongoDB Atlas connection string (server-only)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Random secret used to HMAC/hash server-side session and token values (server-only)
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Cloudflare R2 S3-compatible credentials (server-only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Resend transactional email (server-only)
RESEND_API_KEY=

# Google Places server-side API key
GOOGLE_PLACES_API_KEY=

# Canonical application origin; used when constructing stable guest links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for the Vercel Cron internal endpoint (server-only)
CRON_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
